[Unit]
Description=HUY AI Center Persistent Multi-AI Autonomous Supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/huy-ai/autonomy.env
EnvironmentFile=-%h/.config/huy-ai/provider-secrets.env
ExecStart=/usr/bin/env bash -lc 'cd "$HUY_AI_REPO" && exec npm run autonomy:daemon'
Restart=always
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
