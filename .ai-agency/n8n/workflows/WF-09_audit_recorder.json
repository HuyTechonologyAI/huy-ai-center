  "tags": [
    "HUY_AI_CENTER",
    "NOTE01",
    "SOCIAL_PUBLISHING",
    "2026"
  ],
  "nodes": [
    {
      "id": "node-trigger-01",
      "name": "Webhook Trigger / Ingress",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "wf-09_audit_recorder",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "node-process-02",
      "name": "WF-09 Audit Logger & Provenance Store Execution Engine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Execution handler for WF-09 Audit Logger & Provenance Store\n// Persists immutable cryptographic execution logs into social_audit_logs with zero secret exposure\nconst input = $input.first().json;\n\nreturn [{\n  json: {\n    workflow: 'WF-09 Audit Logger & Provenance Store',\n    status: 'COMPLETED',\n    timestamp: new Date().toISOString(),\n    plane: 'ORCHESTRATION_PLANE',\n    processed_payload: input\n  }\n}];"
      }
    },
    {
      "id": "node-audit-03",
      "name": "Audit Logger",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://huy-ai-node-01:3000/api/v1/social/audit",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "workflow",
              "value": "WF-09 Audit Logger & Provenance Store"
            },
            {
              "name": "status",
              "value": "SUCCESS"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger / Ingress": {
      "main": [
        [
          {
            "node": "WF-09 Audit Logger & Provenance Store Execution Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WF-09 Audit Logger & Provenance Store Execution Engine": {
      "main": [
        [
          {
            "node": "Audit Logger",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
