# ==============================================================================
# HUY TECHNOLOGY AI CENTER — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env or .env.local for development. DO NOT commit actual secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Control Center & Task Queue)
# ------------------------------------------------------------------------------
# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Public anon key (Safe for browser / client-side)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service role key (STRICTLY SERVER-SIDE / WORKER ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------------------------
# 2. WORKER NODE CONFIGURATION (Dell Precision M4800 & Local Worker)
# ------------------------------------------------------------------------------
WORKER_NODE_ID=huy-ai-node-01
WORKER_NODE_NAME="Dell Precision M4800 Primary Node"
WORKER_POLL_INTERVAL_MS=3000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_CONCURRENCY=2
WORKER_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 3. AI SERVICE ADAPTERS (Running on Dell M4800 or Cloud)
# ------------------------------------------------------------------------------

# Ollama local models (Default port 11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# LiteLLM Proxy / Router (Default port 4000)
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=sk-litellm-placeholder

# Langflow Workflow Automation (Default port 7860)
LANGFLOW_BASE_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=langflow-placeholder-token

# n8n Workflow Automation (Default port 5678)
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=n8n-placeholder-api-key

# ------------------------------------------------------------------------------
# 4. CONTROL CENTER WEB APPLICATION
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
