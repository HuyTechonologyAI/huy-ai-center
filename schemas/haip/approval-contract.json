{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HAIPApprovalContract",
  "type": "object",
  "required": [
    "approval_id",
    "requested_at",
    "task_id",
    "action_type",
    "risk_gate",
    "requested_by",
    "rationale",
    "status"
  ],
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string"
    },
    "action_type": {
      "type": "string"
    },
    "risk_gate": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "requested_by": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ]
    },
    "decision_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
