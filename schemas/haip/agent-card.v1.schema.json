{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huyai.vn/schemas/haip/agent-card.v1.schema.json",
  "title": "HAIP Agent Card V1.0",
  "description": "Capability-based specification card for autonomous agents in HUY TECHNOLOGY AI CENTER",
  "type": "object",
  "required": [
    "agent_id",
    "name",
    "version",
    "capabilities",
    "accepted_inputs",
    "output_types",
    "runtime",
    "risk_ceiling",
    "max_parallel_tasks",
    "health_status"
  ],
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical identifier of the agent (e.g., teacher-ai, smarttax-agent, qa-evaluator)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic versioning string"
    },
    "description": {
      "type": "string",
      "description": "Detailed summary of role and responsibilities"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Deterministic list of capabilities (e.g. lesson_planning, slide_generation, tax_computation, code_review)"
    },
    "accepted_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "schema_ref": { "type": "string" },
          "required": { "type": "boolean", "default": true }
        }
      },
      "description": "Contract of acceptable input formats and artifacts"
    },
    "output_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "schema_ref": { "type": "string" },
          "mime_type": { "type": "string" }
        }
      },
      "description": "Contract of emitted output formats and artifact types"
    },
    "runtime": {
      "type": "object",
      "required": ["type", "target_node"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["node_worker", "langflow", "serverless_nextjs", "ollama_direct", "container_sandbox"],
          "description": "Execution environment"
        },
        "target_node": {
          "type": "string",
          "description": "Designated compute node ID, e.g. huy-ai-node-01 or cloud_serverless"
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 128
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "default": 300
        }
      }
    },
    "risk_ceiling": {
      "type": "integer",
      "enum": [0, 1, 2, 3, 4],
      "description": "Maximum risk level this agent is authorized to execute autonomously (0-2: Auto, 3-4: Requires human gate)"
    },
    "max_parallel_tasks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32,
      "default": 2,
      "description": "Maximum concurrent tasks supported by this agent instance"
    },
    "health_status": {
      "type": "string",
      "enum": ["healthy", "degraded", "offline", "maintenance"],
      "default": "healthy"
    },
    "configuration": {
      "type": "object",
      "default": {},
      "properties": {
        "default_model_preference": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mcp_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "metadata": {
      "type": "object",
      "default": {}
    }
  }
}
