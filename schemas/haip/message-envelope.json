{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HAIPMessageEnvelope",
  "type": "object",
  "required": [
    "protocol",
    "version",
    "message_id",
    "timestamp",
    "message_type",
    "sender",
    "recipient",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "enum": [
        "HAIP"
      ]
    },
    "version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "message_id": {
      "type": "string",
      "pattern": "^msg_[a-zA-Z0-9_-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "COMMAND",
        "REQUEST",
        "RESPONSE",
        "EVENT",
        "HANDOFF",
        "CONTROL"
      ]
    },
    "sender": {
      "type": "object",
      "required": [
        "agent_id",
        "department_id"
      ],
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "department_id": {
          "type": "string"
        }
      }
    },
    "recipient": {
      "type": "object",
      "required": [
        "agent_id",
        "department_id"
      ],
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "department_id": {
          "type": "string"
        }
      }
    },
    "correlation_id": {
      "type": "string"
    },
    "parent_message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "security_token": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
