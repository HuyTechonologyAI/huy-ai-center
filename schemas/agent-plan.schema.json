{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentPlan",
  "type": "object",
  "required": ["planId","taskId","model","generatedAt","steps","requiredTools","approvedByGate"],
  "properties": {
    "planId": { "type": "string" },
    "taskId": { "type": "string" },
    "model": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stepIndex","description","riskEstimate"],
        "properties": {
          "stepIndex": { "type": "integer" },
          "description": { "type": "string" },
          "targetFiles": { "type": "array", "items": { "type": "string" } },
          "riskEstimate": { "type": "string", "enum": ["R0","R1","R2","R3","R4"] }
        }
      }
    },
    "requiredTools": { "type": "array", "items": { "type": "string" } },
    "approvedByGate": { "type": "boolean" },
    "estimatedDurationSeconds": { "type": "integer" },
    "rawOutput": { "type": "string" }
  }
}
