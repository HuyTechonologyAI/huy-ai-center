{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutomationTask",
  "description": "Machine-readable contract for every agent bridge task",
  "type": "object",
  "required": ["taskId","title","objective","repository","scope","risk","execution","verification","sourceControl"],
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]*[a-z0-9]$",
      "description": "Unique task identifier, e.g. bridge-20260922-001"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "repository": {
      "type": "object",
      "required": ["root","baseRef","taskBranch"],
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string" },
        "baseRef": { "type": "string" },
        "taskBranch": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["allowedPaths","forbiddenPaths"],
      "additionalProperties": false,
      "properties": {
        "allowedPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbiddenPaths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "risk": {
      "type": "object",
      "required": ["level","reason"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["R0","R1","R2","R3","R4"]
        },
        "reason": { "type": "string" }
      }
    },
    "execution": {
      "type": "object",
      "required": ["maxCycles","timeoutSeconds"],
      "additionalProperties": false,
      "properties": {
        "maxCycles": { "type": "integer", "minimum": 1, "maximum": 5 },
        "timeoutSeconds": { "type": "integer", "minimum": 60, "maximum": 7200 }
      }
    },
    "verification": {
      "type": "object",
      "required": ["commands"],
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sourceControl": {
      "type": "object",
      "required": ["commitAllowed","pushFeatureBranchAllowed","prCreationAllowed","mergeAllowed"],
      "additionalProperties": false,
      "properties": {
        "commitAllowed": { "type": "boolean" },
        "pushFeatureBranchAllowed": { "type": "boolean" },
        "prCreationAllowed": { "type": "boolean" },
        "mergeAllowed": {
          "type": "boolean",
          "const": false,
          "description": "ALWAYS false — merge is R3/HUMAN. Bridge cannot merge."
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
