{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApprovalRequest",
  "type": "object",
  "required": ["taskId","requestedAction","riskLevel","whyApprovalRequired","affectedResources","rollbackProcedure","validationCompleted","recommendedNextStep","createdAt"],
  "properties": {
    "taskId": { "type": "string" },
    "requestedAction": { "type": "string" },
    "riskLevel": { "type": "string", "enum": ["R3","R4"] },
    "whyApprovalRequired": { "type": "string" },
    "affectedResources": { "type": "array", "items": { "type": "string" } },
    "proposedCommand": { "type": "string" },
    "rollbackProcedure": { "type": "string" },
    "validationCompleted": { "type": "array", "items": { "type": "string" } },
    "recommendedNextStep": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
